# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
dist/
state/
# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build output
bin/

# Compiled binaries (root-level build outputs)
/adhd
/main

# Machine-local agent/IDE config. Ignore specific files, never the whole
# `.claude/` or `.cursor/` directory: those contain tracked project skills
# (`.claude/skills/`, `.cursor/skills/`) that must stay committable. Excluding
# an entire directory that holds tracked files makes `git add` refuse them.
.mcp.json
opencode.json
.codex/config.toml
.claude/launch.json
.cursor/mcp.json
.pi/extensions/open-knowledge.ts

# Editor/IDE
.DS_Store
.claude/settings.local.json
